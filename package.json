{
  "name": "codex-pocket",
  "version": "0.1.0",
  "description": "Self-hosted browser/PWA client for official Codex app-server runtimes locally and over SSH",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types gateway.ts",
    "gateway": "node --experimental-strip-types gateway.ts",
    "probe": "node --experimental-strip-types probe.ts",
    "probe-remote": "node --experimental-strip-types probe.ts --ssh",
    "test": "node --experimental-strip-types --test tests/pocket-logic.test.mjs tests/deepseek.test.mjs",
    "test:deepseek:live": "node --experimental-strip-types scripts/deepseek-smoke.mjs",
    "test:browser": "node --experimental-strip-types tests/task-local.browser.mjs && node --experimental-strip-types tests/deepseek.browser.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "markdown-it": "14.3.1"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
